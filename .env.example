# Configuration for the network sandbox. Copy to ".env" and adjust.
#   cp .env.example .env
#
# Precedence in the helper scripts: command-line argument > environment variable
# > value from this file > built-in default.

# --- Project / base image ------------------------------------------------
SANDBOX_PROJECT_NAME=docker-sandbox-socks5
SANDBOX_BASE_IMAGE=ubuntu:26.04
SANDBOX_ROUTER_NAME=sandbox-router
SANDBOX_APP_NAME=sandbox-app

# --- Network -------------------------------------------------------------
# The subnet is fixed so the optional host firewall can match on it. The bridge
# name is fixed so host rules can match on the interface.
SANDBOX_SUBNET=172.28.77.0/24
SANDBOX_BRIDGE=br-sandbox
SANDBOX_SOCKS_PORT=1080
SANDBOX_REDSOCKS_PORT=12345
# UID that runs ssh and redsocks inside the router. Must differ from the UID the
# workload runs as (the app runs as root, UID 0, by default).
SANDBOX_TUNNEL_UID=10002

# --- SSH tunnel ----------------------------------------------------------
# The external ssh server that provides the SOCKS5 endpoint via "ssh -D".
SANDBOX_SSH_HOST=ssh.example.com
SANDBOX_SSH_PORT=22
SANDBOX_SSH_USER=tunneluser
# Private key and known_hosts, mounted read-only into the router. Strict host
# key checking is enforced, so known_hosts must contain the server's key.
SANDBOX_SSH_KEY=./secrets/id_ed25519
SANDBOX_SSH_KNOWN_HOSTS=./secrets/known_hosts
# Seconds to wait for the tunnel's SOCKS port before giving up at startup.
SANDBOX_TUNNEL_WAIT=30

# --- DNS -----------------------------------------------------------------
# Upstream resolver, reached over TCP through the tunnel. Must be an IP address.
SANDBOX_DNS_UPSTREAM=9.9.9.9

# --- Application (the sandboxed workload) --------------------------------
# Extra apt packages to install into the app image at build time (optional).
SANDBOX_APP_PACKAGES=
# Command to run in the app container. Leave empty to idle for inspection.
SANDBOX_APP_CMD=
# Pin the workload to specific CPUs (e.g. "0-7" or "0,2,4"). Empty = all CPUs.
# Prefer this over a CPU quota, which would throttle throughput.
SANDBOX_APP_CPUSET=
# Shared memory size for the app container.
SANDBOX_APP_SHM_SIZE=256m

# --- Host firewall (optional second enforcement layer) -------------------
# When 1, run.sh applies host rules (INPUT + DOCKER-USER) before starting.
SANDBOX_APPLY_HOST_RULES=0
